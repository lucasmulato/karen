# SynapseVault API (MCP Gateway + HTTP REST)

# PostgreSQL connection string.
# In Docker this is injected by docker-compose; override locally if needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synapsevault

# Port for the HTTP REST surface (also serves the MCP stdio transport).
# Default: 3000
HTTP_PORT=3000

# Reasoning agent (OpenAI-compatible chat-completions).
# Local llama.cpp needs no real key — any non-empty value enables the agent.
# For Groq, set a real key and change BASE_URL/MODEL.
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=karen
# Draft (EQ-LLM-01): with the proposed internal llm-engine service in compose,
# use LLM_BASE_URL=http://llm-engine:11434/v1 and LLM_MODEL=qwen3:4b.
# To keep the host llama.cpp, leave the values above and do not apply the draft.

# Shared secret injected by OpenResty into proxied /api/ requests.
KAREN_API_KEY=
# Optional: only set if a separate front-end needs cross-origin access.
CORS_ORIGIN=

# Markdown memory vault (plain files, outside the repo by default).
KAREN_VAULT_DIR=/home/admin/models/karen-vault

# KAREN lead generation.
# Default provider is OSM/OpenStreetMap: free, no key, no per-result charge.
# Set LEAD_PROVIDER=apify plus a token below to use the paid Google Maps scraper.
LEAD_PROVIDER=osm
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_RADIUS_M=3000

APIFY_TOKEN=
# Hard ceiling for maxCrawledPlacesPerSearch (1-200). 50 places ~= US$ 0.08.
APIFY_MAX_PLACES=50
# allPlaces | placesWithWebsite | placesWithoutWebsite
APIFY_WEBSITE_FILTER=placesWithoutWebsite
# Filled into the drafted messages.
OPERATOR_NAME=
KAREN_EXAMPLE_LINK=

# Optional semantic search via Cloudflare Workers AI (free tier, zero data retention).
# Leave blank to use keyword search only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024

# Morning digest (planned delivery via SMTP). Never commit real credentials.
SMTP_USER=
SMTP_APP_PASSWORD=
REPORT_TO=

# Offsite encrypted backup (private git repo + separate passphrase!)
KAREN_OFFSITE_REPO=
KAREN_BACKUP_PASSPHRASE=

# Session auth (self-hosted; Google OAuth can be added later)
KAREN_SESSION_SECRET=
KAREN_USERS_FILE=/home/admin/models/karen-users.json

# --- Climara / multi-company (Fase 0) ---------------------------------------
# Marketing user: Climara-only scope, NO MFA. Provisioned idempotently at boot.
# Keep the password in this env file (mode 600), never in the repository.
KAREN_MARKETING_USER=
KAREN_MARKETING_PASSWORD=
# Brand profile (optional overrides). Never invent the offer: leave blank until
# the briefing is filled in 10 Projects/Climara.md.
CLIMARA_OPERATOR_NAME=
CLIMARA_EXAMPLE_LINK=
CLIMARA_OFFER=
# Action items file shared by the watchdog and urgent e-mail alerts.
KAREN_ACTION_ITEMS=/home/admin/karen/api/data/action-items.json

# --- WhatsApp Cloud API (Fase 1 — not enabled yet) --------------------------
# Requires a DEDICATED business number; a personal number cannot be migrated.
# WA_VERIFY_TOKEN=
# WA_ACCESS_TOKEN=
# WA_PHONE_NUMBER_ID=
# WA_WABA_ID=
# WA_APP_SECRET=
