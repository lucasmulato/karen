# SynapseVault API (MCP Gateway + HTTP REST)

# PostgreSQL connection string.
# In Docker this is injected by docker-compose; override locally if needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synapsevault

# Port for the HTTP REST surface (also serves the MCP stdio transport).
# Default: 3000
HTTP_PORT=3000

# Reasoning agent (OpenAI-compatible chat-completions).
# Local llama.cpp needs no real key — any non-empty value enables the agent.
# For Groq, set a real key and change BASE_URL/MODEL.
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=karen

# KAREN lead generation (Apify Google Maps Scraper).
# Get a token from https://console.apify.com/settings/integrations.
# Without a token the lead endpoints return 503 and chat still works.
APIFY_TOKEN=
# Hard ceiling for maxCrawledPlacesPerSearch (1-200). 50 places ~= US$ 0.08.
APIFY_MAX_PLACES=50
# allPlaces | placesWithWebsite | placesWithoutWebsite
APIFY_WEBSITE_FILTER=placesWithoutWebsite
# Filled into the drafted messages.
OPERATOR_NAME=
KAREN_EXAMPLE_LINK=

# Optional semantic search via Cloudflare Workers AI (free tier, zero data retention).
# Leave blank to use keyword search only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_DIM=1024
